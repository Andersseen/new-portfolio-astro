---
import "@styles/global.css";
import BaseHead from "@componentes/BaseHead.astro";
import Navbar from "@componentes/Navbar";
import LanguageSelector from "@componentes/LanguageSelector.astro";
import Footer from "@componentes/Footer.astro";
import PageLoader from "@componentes/PageLoader.astro";
import Analytics from "@vercel/analytics/astro";
import { getLanguageFromPath } from "@i18n/config";
import { loadMessages } from "@i18n/glossa";
import { MESSAGES_ELEMENT_ID } from "@i18n/utils";


export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;

const lang = getLanguageFromPath(Astro.url.pathname);

// The current locale's catalog is embedded for client islands (`t()` reads
// it in the browser). `<` is escaped so the JSON can't close the script tag.
// Prerendered pages already loaded it (and fail the build if Glossa is down);
// the on-demand 404 degrades to raw keys instead of a 500.
const messages = await loadMessages(lang).catch(() => ({}));
const messagesJson = JSON.stringify(messages).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body>
    <script
      type="application/json"
      id={MESSAGES_ELEMENT_ID}
      data-lang={lang}
      set:html={messagesJson}
    />

    <PageLoader />

    <Navbar client:idle>
      <LanguageSelector />
    </Navbar>

    <main class="pt-8">


      <slot />
    </main>

    <Footer />
    <Analytics />
  </body>
</html>


<script>
  import "@scripts/theme-controller.ts";
</script>
